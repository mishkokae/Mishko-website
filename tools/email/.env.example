# Copy this file to ".env" (same folder) and fill it in. Never commit .env.

# Cloudflare API token with permissions:
#   Zone    -> Email Routing Rules     -> Edit
#   Account -> Email Routing Addresses -> Edit
CF_API_TOKEN=

# Found on your domain's Overview page in the Cloudflare dashboard (right sidebar)
CF_ZONE_ID=
CF_ACCOUNT_ID=

# Your domain, e.g. mishko.com
CF_DOMAIN=

# Inbox new addresses forward to unless you pick another one
CF_DEFAULT_DESTINATION=
